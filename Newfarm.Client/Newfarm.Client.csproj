<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
        <!-- C# 9 so the source stays compatible with Unity's compiler. -->
        <LangVersion>9</LangVersion>
        <Nullable>enable</Nullable>
        <AssemblyName>Newfarm.Client</AssemblyName>
        <RootNamespace>Newfarm</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>Newfarm client - talks to an out-of-band session directory for host migration</Description>
        <Version>0.1.0</Version>
    </PropertyGroup>

</Project>
